page {
  --color-bg: #111317;
  --color-surface: #191c21;
  --color-surface-raised: #20242a;
  --color-surface-subtle: #24282f;
  --color-text: #f2f4f7;
  --color-text-secondary: #b2b7c0;
  --color-text-tertiary: #7f8691;
  --color-border: #2a2f37;
  --color-primary: #4da3ff;
  --color-primary-strong: #2f8ff5;
  --color-primary-soft: rgba(77, 163, 255, 0.14);
  --color-success: #39c58a;
  --color-success-soft: rgba(57, 197, 138, 0.13);
  --color-warning: #f0a84b;
  --color-warning-soft: rgba(240, 168, 75, 0.14);
  --color-danger: #ff6b67;
  --color-danger-soft: rgba(255, 107, 103, 0.13);
  --radius-sm: 12rpx;
  --radius-md: 18rpx;
  --radius-lg: 24rpx;
  --space-page: 28rpx;
  --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
  --ease-in-out: cubic-bezier(0.77, 0, 0.175, 1);
  min-height: 100%;
  width: 100%;
  max-width: 100%;
  overflow-x: hidden;
  background: #111317;
  background: var(--color-bg);
  color: var(--color-text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

view,
text,
input,
textarea,
button,
navigator,
image {
  box-sizing: border-box;
}

.container {
  display: flex;
  flex-direction: column;
}

button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  min-width: 0;
  max-width: 100%;
  padding: 0 28rpx;
  border-radius: var(--radius-sm);
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.25;
  text-align: center;
  color: var(--color-text);
  background: var(--color-surface-subtle);
  transition: transform 120ms var(--ease-out), opacity 120ms ease;
}

button:focus {
  outline: 0;
}

button::after {
  border: none;
}

button:active,
.tap-target:active {
  transform: scale(0.98);
}

button[disabled] {
  opacity: 0.5;
}

input,
textarea {
  color: var(--color-text);
  caret-color: var(--color-primary);
}

input::placeholder,
textarea::placeholder {
  color: var(--color-text-tertiary);
}

.page-shell {
  box-sizing: border-box;
  width: 100%;
  max-width: 100%;
  min-height: 100vh;
  overflow-x: hidden;
  padding: 24rpx var(--space-page) calc(64rpx + env(safe-area-inset-bottom));
}

.page-shell > view,
.page-shell .surface,
.page-shell .section-row {
  min-width: 0;
  max-width: 100%;
}

.surface {
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
}

.section-title {
  color: var(--color-text);
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.3;
}

.section-caption {
  color: var(--color-text-tertiary);
  font-size: 24rpx;
}

.primary-button {
  color: #07121e;
  background: var(--color-primary);
}

.success-button {
  color: #07150f;
  background: var(--color-success);
}

.secondary-button {
  color: var(--color-primary);
  background: var(--color-primary-soft);
}

.danger-button {
  color: #1d0807;
  background: var(--color-danger);
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  color: var(--color-text-secondary);
  font-size: 27rpx;
  font-weight: 500;
}

.control {
  box-sizing: border-box;
  width: 100%;
  min-height: 92rpx;
  padding: 0 22rpx;
  border: 2rpx solid transparent;
  border-radius: var(--radius-sm);
  font-size: 31rpx;
  line-height: 92rpx;
  background: var(--color-surface-subtle);
}

.control-focus {
  border-color: var(--color-primary);
  background: var(--color-surface);
}

.page-title {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.12;
  letter-spacing: -1.2rpx;
}

.page-subtitle {
  margin-top: 8rpx;
  color: var(--color-text-tertiary);
  font-size: 25rpx;
}

.section-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 34rpx 2rpx 16rpx;
}

.section-row > view:first-child {
  min-width: 0;
}

.text-link {
  min-height: 64rpx;
  padding: 12rpx 0 12rpx 24rpx;
  color: var(--color-primary);
  font-size: 25rpx;
  line-height: 40rpx;
}

.money-display {
  font-variant-numeric: tabular-nums;
  letter-spacing: -1rpx;
}

.page-state {
  padding: 120rpx 30rpx;
  color: var(--color-text-tertiary);
  text-align: center;
}

.page-state-title {
  color: var(--color-text-secondary);
  font-size: 31rpx;
  font-weight: 600;
}

.page-state-message {
  margin-top: 10rpx;
  font-size: 26rpx;
}

.error-text {
  color: var(--color-danger);
}

.success-enter {
  animation: success-enter 180ms var(--ease-out) both;
}

@keyframes success-enter {
  from {
    opacity: 0;
    transform: translateY(8rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (prefers-reduced-motion: reduce) {
  button,
  .tap-target {
    transition: opacity 120ms ease;
  }

  button:active,
  .tap-target:active {
    transform: none;
  }

  .success-enter {
    animation: reduced-fade 120ms ease both;
  }
}

@keyframes reduced-fade {
  from { opacity: 0; }
  to { opacity: 1; }
}
