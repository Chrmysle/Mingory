.label { display: block; margin-bottom: 12rpx; color: var(--color-text-secondary); font-size: 27rpx; font-weight: 500; }
input { box-sizing: border-box; width: 100%; height: 92rpx; padding: 0 22rpx; border: 2rpx solid transparent; border-radius: var(--radius-sm); color: var(--color-text); font-size: 31rpx; line-height: 92rpx; background: var(--color-surface-subtle); }
.hint { margin-top: 14rpx; color: var(--color-text-tertiary); font-size: 22rpx; }
.tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 10rpx; }
.tag { width: auto; min-width: 80rpx; min-height: 64rpx; margin: 0; padding: 0 18rpx; border-radius: 999rpx; color: var(--color-primary); font-size: 24rpx; line-height: 1.2; background: var(--color-primary-soft); }
