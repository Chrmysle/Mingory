.restock-page { padding-top: 28rpx; }
.summary { display: flex; align-items: center; justify-content: space-between; padding: 28rpx; }
.summary-caption { margin-top: 6rpx; color: var(--color-text-tertiary); font-size: 25rpx; }
.summary-count { display: flex; flex-direction: column; align-items: flex-end; color: var(--color-danger); }
.summary-count text:first-child { font-size: 42rpx; font-weight: 700; line-height: 1.1; }
.summary-count text:last-child { margin-top: 2rpx; font-size: 23rpx; }
.supplier-list { margin-top: 22rpx; padding: 0 24rpx; }
.supplier-row { display: grid; grid-template-columns: minmax(0, 1fr) auto 24rpx; gap: 16rpx; align-items: center; min-height: 116rpx; padding: 20rpx 4rpx; border-bottom: 1rpx solid var(--color-border); transition: transform 120ms var(--ease-out), opacity 120ms ease; }
.supplier-row:last-child { border-bottom: 0; }
.supplier-info { min-width: 0; }
.supplier-name { overflow: hidden; font-size: 30rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.supplier-meta { margin-top: 4rpx; color: var(--color-text-tertiary); font-size: 24rpx; }
.supplier-status { padding: 8rpx 14rpx; border-radius: 999rpx; font-size: 23rpx; white-space: nowrap; }
.supplier-status.waiting { color: var(--color-danger); background: var(--color-danger-soft); }
.supplier-status.normal { color: var(--color-success); background: var(--color-success-soft); }
.chevron { color: var(--color-text-tertiary); font-size: 38rpx; line-height: 1; }
.retry-button { width: 220rpx; margin-top: 26rpx; }
.empty-state { margin-top: 22rpx; }
