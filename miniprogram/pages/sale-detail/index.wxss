.sale-header,.detail-section { margin-bottom: 20rpx; padding: 28rpx; }
.sale-header { position: relative; }
.name { font-size: 39rpx; font-weight: 700; }
.order-summary { margin-top: 8rpx; color: var(--color-text-secondary); }
.amount { margin-top: 26rpx; padding-top: 22rpx; border-top: 1rpx solid var(--color-border); font-size: 48rpx; font-weight: 700; }
.amount-caption { color: var(--color-text-tertiary); font-size: 23rpx; }
.detail-section .section-title { margin-bottom: 10rpx; font-size: 29rpx; }
.order-line { padding: 20rpx 0; border-bottom: 1rpx solid var(--color-border); }
.order-line:last-child { border-bottom: 0; }
.line-head { display: flex; align-items: baseline; justify-content: space-between; gap: 20rpx; }
.line-name { min-width: 0; font-size: 28rpx; font-weight: 620; }
.line-amount { flex: none; font-weight: 650; }
.line-meta { margin-top: 6rpx; color: var(--color-text-tertiary); font-size: 23rpx; }
.line-bottom { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.delete-line { flex: none; min-height: 58rpx; margin: 8rpx 0 0; padding: 0 20rpx; color: var(--color-danger); font-size: 22rpx; background: var(--color-danger-soft); }
.gift { margin-left: 6rpx; padding: 3rpx 9rpx; border-radius: 999rpx; color: var(--color-warning); font-size: 20rpx; background: var(--color-warning-soft); }
.row { display: flex; justify-content: space-between; gap: 24rpx; min-height: 70rpx; padding: 16rpx 0; border-bottom: 1rpx solid var(--color-border); }
.row:last-of-type { border-bottom: 0; }
.row text:first-child { color: var(--color-text-tertiary); }
.row text:last-child { max-width: 62%; text-align: right; }
.profit text:last-child { color: var(--color-success); font-size: 31rpx; font-weight: 700; }
.profit.negative text:last-child { color: var(--color-danger); }
.record-id { margin-top: 18rpx; color: var(--color-text-tertiary); font-size: 22rpx; word-break: break-all; }
.danger-zone { margin-top: 30rpx; padding: 24rpx; border: 1rpx solid rgba(255,107,103,.3); }
.danger-caption { margin-top: 8rpx; color: var(--color-text-tertiary); font-size: 23rpx; line-height: 1.55; }
.delete-order { margin-top: 20rpx; color: var(--color-danger); background: var(--color-danger-soft); }
