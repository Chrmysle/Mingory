<view class="page-shell"><view class="page-state" wx:if="{{loading}}">正在加载销售订单…</view><view class="page-state error-text" wx:elif="{{error}}">{{error}}</view><block wx:elif="{{order}}">
  <view class="sale-header surface"><view class="name">销售订单</view><view class="status {{order.status==='cancelled'?'cancelled':''}}">{{order.status==='cancelled'?'已撤销':'正常销售'}}</view><view class="order-summary">{{order.itemCount}}种商品 · 共{{order.totalQuantity}}件</view><view class="amount money-display">¥{{order.totalAmountDisplay}}</view><view class="amount-caption">整单实收</view></view>
  <view class="detail-section surface"><view class="section-title">商品明细</view><view class="order-line" wx:for="{{items}}" wx:key="_id"><view class="line-head"><view class="line-name">{{item.productName}}{{item.specification?' · '+item.specification:''}} <text class="gift" wx:if="{{item.isGift}}">赠品</text></view><view class="line-amount money-display">¥{{item.totalAmountDisplay}}</view></view><view class="line-meta">×{{item.quantity}}{{item.unit||''}} · 单价 ¥{{item.unitPriceDisplay}} · 成本 ¥{{item.totalCostDisplay}}</view></view></view>
  <view class="detail-section surface"><view class="section-title">成本与毛利润</view><view class="row"><text>整单成本</text><text>¥{{order.totalCostDisplay}}</text></view><view class="row profit {{order.grossProfitCent<0?'negative':''}}"><text>毛利润</text><text>¥{{order.grossProfitDisplay}}</text></view></view>
  <view class="detail-section surface"><view class="section-title">记录信息</view><view class="row"><text>销售人员</text><text>{{order.operatorName||'未知操作人'}}</text></view><view class="row"><text>销售时间</text><text>{{order.timeDisplay}}</text></view><view class="row" wx:if="{{order.status==='cancelled'}}"><text>撤销人员</text><text>{{order.cancelledByName||'未知操作人'}}</text></view><view class="row" wx:if="{{order.status==='cancelled'}}"><text>撤销时间</text><text>{{order.cancelledAtDisplay||'时间未知'}}</text></view><view class="row" wx:if="{{order.status==='cancelled'}}"><text>撤销原因</text><text>{{order.cancelReason||'撤销销售'}}</text></view><view class="record-id">订单 ID：<text selectable="true">{{order._id}}</text></view></view>
  <button class="cancel-button" wx:if="{{order.status==='normal'}}" bindtap="cancelSale" loading="{{cancelling}}" disabled="{{cancelling}}">撤销这笔销售</button>
</block></view>
