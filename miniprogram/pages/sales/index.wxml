<view class="page">
  <view class="filters"><button class="{{type==='today'?'active':''}}" data-type="today" bindtap="choosePreset">今天</button><button class="{{type==='yesterday'?'active':''}}" data-type="yesterday" bindtap="choosePreset">昨天</button><button class="{{type==='week'?'active':''}}" data-type="week" bindtap="choosePreset">本周</button><button class="{{type==='month'?'active':''}}" data-type="month" bindtap="choosePreset">本月</button><button class="{{type==='custom'?'active':''}}" data-type="custom" bindtap="choosePreset">自定义</button></view>
  <view class="status-filters"><button class="{{saleStatus==='all'?'active':''}}" data-status="all" bindtap="chooseStatus">全部</button><button class="{{saleStatus==='normal'?'active':''}}" data-status="normal" bindtap="chooseStatus">正常</button><button class="{{saleStatus==='cancelled'?'active cancelled':''}}" data-status="cancelled" bindtap="chooseStatus">已撤销</button></view>
  <view class="custom" wx:if="{{type==='custom'}}"><view><picker mode="date" value="{{startDate}}" data-field="startDate" bindchange="onDateChange"><view>{{startDate}}</view></picker><text>至</text><picker mode="date" value="{{endDate}}" data-field="endDate" bindchange="onDateChange"><view>{{endDate}}</view></picker></view><button bindtap="applyCustom">查询</button></view>
  <view class="range">{{rangeLabel}} · 按顾客整单展示</view><view class="error" wx:if="{{error}}">{{error}}</view><view class="empty" wx:if="{{!loading&&!error&&list.length===0}}">{{rangeLabel}}还没有销售记录</view>
  <view class="sale-item {{item.status==='cancelled'?'cancelled-item':''}}" wx:for="{{list}}" wx:key="_id" data-id="{{item._id}}" bindtap="open"><view class="top"><view><view class="name">{{item.itemCount}}种商品 · {{item.totalQuantity}}件 <text class="cancelled-badge" wx:if="{{item.status==='cancelled'}}">已撤销</text></view><view class="spec">{{item.firstProductName}}{{item.itemCount>1?' 等':''}}</view></view><view class="amount money-display">¥{{item.totalAmountDisplay}}</view></view><view class="middle"><text>{{item.operatorName||'未知操作人'}}</text><text class="profit {{item.grossProfitCent<0?'negative':''}}">毛利润 ¥{{item.grossProfitDisplay}}</text></view><view class="meta"><text>{{item.status==='cancelled'?'撤销订单':'销售订单'}}</text><text>{{item.timeDisplay}}</text></view></view>
  <view class="footer" wx:if="{{loading}}">加载中…</view><view class="footer" wx:elif="{{list.length&&!hasMore}}">已经到底了</view>
</view>
