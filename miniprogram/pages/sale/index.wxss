.product-context,.sale-form,.success-panel { margin-bottom: 22rpx; padding: 30rpx; }
.name { font-size: 42rpx; font-weight: 700; }
.spec { display: inline-block; margin-top: 10rpx; padding: 5rpx 12rpx; border-radius: 8rpx; color: var(--color-primary); font-size: 25rpx; background: var(--color-primary-soft); }
.context-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20rpx; margin-top: 26rpx; padding-top: 24rpx; border-top: 1rpx solid var(--color-border); }
.context-grid view { display: flex; flex-direction: column; }
.context-grid text:first-child { color: var(--color-text-tertiary); font-size: 24rpx; }
.context-grid text:last-child { margin-top: 4rpx; font-size: 30rpx; font-weight: 600; }
.label { margin-bottom: 16rpx; color: var(--color-text-secondary); font-size: 27rpx; font-weight: 500; }
.quantity { display: flex; align-items: center; justify-content: center; gap: 18rpx; }
.quantity button { width: 104rpx; height: 92rpx; margin: 0; color: var(--color-primary); font-size: 42rpx; background: var(--color-primary-soft); }
.quantity input,.price-input { box-sizing: border-box; height: 92rpx; padding: 0 20rpx; border-radius: var(--radius-sm); font-size: 36rpx; line-height: 92rpx; text-align: center; background: var(--color-surface-subtle); }
.quantity input { width: 188rpx; }
.price-input { width: 100%; }
.divider { margin: 30rpx 0; border-top: 1rpx solid var(--color-border); }
.total { display: flex; align-items: baseline; justify-content: space-between; margin-top: 26rpx; padding-top: 22rpx; border-top: 1rpx solid var(--color-border); }
.total text:first-child { color: var(--color-text-secondary); }
.total text:last-child { font-size: 40rpx; font-weight: 700; }
.confirm { height: 104rpx; font-size: 32rpx; }
.submit-hint { margin-top: 10rpx; color: var(--color-text-tertiary); font-size: 23rpx; text-align: center; }
.success-panel { text-align: center; }
.success-mark { display: flex; align-items: center; justify-content: center; width: 82rpx; height: 82rpx; margin: 6rpx auto 18rpx; border-radius: 50%; color: #07150f; font-size: 46rpx; font-weight: 700; background: var(--color-success); }
.success-title { font-size: 39rpx; font-weight: 700; }
.success-product { margin-top: 12rpx; color: var(--color-text-secondary); font-size: 28rpx; }
.success-total { margin-top: 20rpx; font-size: 52rpx; font-weight: 700; }
.success-meta { display: flex; justify-content: center; gap: 28rpx; margin-top: 12rpx; color: var(--color-text-secondary); font-size: 25rpx; }
.success-panel button { margin-top: 26rpx; }
.success-panel button + button { margin-top: 12rpx; }
