.items-page { padding-top: 28rpx; }
.supplier-header { padding: 26rpx 28rpx; }
.supplier-label { color: var(--color-text-tertiary); font-size: 23rpx; }
.supplier-title { margin-top: 4rpx; font-size: 36rpx; font-weight: 700; }
.supplier-summary { margin-top: 8rpx; color: var(--color-danger); font-size: 25rpx; }
.mode-switch { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 6rpx; margin-top: 20rpx; padding: 6rpx; background: var(--color-surface); }
.mode-option { display: flex; align-items: center; justify-content: center; min-height: 76rpx; border-radius: 12rpx; color: var(--color-text-secondary); font-weight: 600; }
.mode-option.active { color: var(--color-primary); background: var(--color-primary-soft); }
.product-list { margin-top: 20rpx; }
.product-group { margin-bottom: 18rpx; padding: 0 24rpx; }
.product-heading { display: flex; align-items: center; justify-content: space-between; min-height: 92rpx; border-bottom: 1rpx solid var(--color-border); }
.product-name { min-width: 0; overflow: hidden; font-size: 31rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.product-count { flex: none; margin-left: 18rpx; color: var(--color-text-tertiary); font-size: 23rpx; }
.variant-row { display: grid; grid-template-columns: minmax(0, 1fr) 124rpx; gap: 20rpx; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid var(--color-border); }
.variant-row:last-child { border-bottom: 0; }
.variant-main { min-width: 0; }
.variant-spec { margin-bottom: 8rpx; font-size: 29rpx; font-weight: 600; }
.stock-line { display: flex; flex-wrap: wrap; gap: 5rpx 22rpx; color: var(--color-text-secondary); font-size: 24rpx; }
.status-badge { display: inline-flex; margin-top: 12rpx; padding: 5rpx 12rpx; border-radius: 999rpx; font-size: 22rpx; }
.status-badge.out { color: var(--color-danger); background: var(--color-danger-soft); font-weight: 600; }
.status-badge.low { color: var(--color-warning); background: var(--color-warning-soft); }
.status-badge.normal { color: var(--color-success); background: var(--color-success-soft); }
.status-badge.unset { color: var(--color-text-tertiary); background: var(--color-surface-subtle); }
.stock-in-button { width: 124rpx; min-height: 72rpx; margin: 0; padding: 0 16rpx; font-size: 27rpx; }
.empty-state { margin-top: 20rpx; padding-left: 24rpx; padding-right: 24rpx; }
.view-all-button, .retry-button { width: 240rpx; margin-top: 26rpx; }
