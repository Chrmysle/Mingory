<view class="page-shell items-page">
  <view class="supplier-header surface">
    <view class="supplier-label">供货商</view>
    <view class="supplier-title">{{displayName}}</view>
    <view class="supplier-summary">需要补货 {{restockSkuCount}} 项</view>
  </view>

  <view class="mode-switch surface">
    <view class="mode-option {{!includeAll?'active':''}}" data-mode="restock" bindtap="switchMode">需要补货</view>
    <view class="mode-option {{includeAll?'active':''}}" data-mode="all" bindtap="switchMode">全部商品</view>
  </view>

  <view class="page-state" wx:if="{{loading}}">正在读取最新库存…</view>
  <view class="page-state" wx:elif="{{error}}">
    <view class="page-state-title error-text">查询失败</view>
    <view class="page-state-message">{{error}}</view>
    <button class="secondary-button retry-button" bindtap="loadItems">重新加载</button>
  </view>
  <view class="page-state surface empty-state" wx:elif="{{!groups.length}}">
    <view class="page-state-title">{{includeAll?'该供货商暂无商品':'这个供货商目前没有需要补货的商品'}}</view>
    <view class="page-state-message" wx:if="{{!includeAll}}">所有设置了库存预警的商品目前库存正常。</view>
    <button class="secondary-button view-all-button" wx:if="{{!includeAll}}" bindtap="showAll">查看全部商品</button>
  </view>

  <view class="product-list" wx:else>
    <view class="product-group surface" wx:for="{{groups}}" wx:key="productId">
      <view class="product-heading">
        <view class="product-name">{{item.name}}</view>
        <view class="product-count" wx:if="{{item.variants.length > 1}}">{{item.variants.length}} 个规格</view>
      </view>
      <view class="variant-row" wx:for="{{item.variants}}" wx:for-item="variant" wx:key="variantId">
        <view class="variant-main">
          <view class="variant-spec" wx:if="{{variant.specification}}">{{variant.specification}}</view>
          <view class="stock-line">
            <text>当前库存 {{variant.stock}}{{item.unit||''}}</text>
            <text wx:if="{{variant.warningStock!==null}}">预警库存 {{variant.warningStock}}{{item.unit||''}}</text>
            <text wx:else>未设置预警库存</text>
          </view>
          <view class="status-badge {{variant.statusClass}}">{{variant.statusLabel}}</view>
        </view>
        <button class="stock-in-button primary-button" data-variant-id="{{variant.variantId}}" catchtap="stockIn">入库</button>
      </view>
    </view>
  </view>
</view>
