<auth-gate status="{{authStatus}}" message="{{authMessage}}" bindretry="retryAuthorization" />
<block wx:if="{{authStatus === 'authorized'}}">
<view class="page-shell archive-page">
  <view class="page-title">归档商品</view>
  <view class="page-subtitle">归档商品不会参与销售和库存操作，可在这里恢复或安全永久删除</view>

  <view class="page-state error-text" wx:if="{{error}}"><view class="page-state-title error-text">归档加载失败</view><view class="page-state-message">{{error}}</view></view>
  <view class="page-state" wx:if="{{!loading&&!error&&list.length===0}}"><view class="page-state-title">归档是空的</view><view class="page-state-message">归档后的商品会集中显示在这里</view></view>

  <view class="archive-list surface" wx:if="{{list.length}}">
    <view class="archive-item tap-target" wx:for="{{list}}" wx:key="_id" data-id="{{item._id}}" bindtap="open">
      <image class="thumb" src="{{item.imageFileID||'/images/default-goods-image.png'}}" mode="aspectFill"/>
      <view class="archive-main"><view class="name">{{item.name}}</view><view class="code">{{item.productCode}}</view><view class="time">归档于 {{item.archivedAtDisplay}}</view></view>
      <view class="chevron">›</view>
    </view>
  </view>
  <view class="list-footer" wx:if="{{loading}}">正在加载…</view><view class="list-footer" wx:elif="{{list.length&&!hasMore}}">已显示全部归档商品</view>
</view>
</block>
