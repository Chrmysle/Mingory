<view class="page-shell">
  <view class="global-header" wx:if="{{global}}"><view class="page-title">{{title}}</view><view class="page-subtitle">{{title==='进货记录'?'查看每次商品入库':'销售、入库、调整和盘点都会记录'}}</view></view>
  <view class="log-header surface" wx:if="{{product}}"><view><view class="name">{{product.name}}</view><view class="spec" wx:if="{{variant.specification}}">{{variant.specification}}</view></view><view class="stock"><text>当前库存</text><text>{{variant.stock}}{{product.unit||''}}</text></view></view>
  <view class="page-state error-text" wx:if="{{error}}">{{error}}</view><view class="page-state" wx:if="{{!loading&&!error&&list.length===0}}"><view class="page-state-title">{{emptyText}}</view><view class="page-state-message">{{title==='进货记录'?'完成商品入库后会显示在这里':'库存发生变化后会显示在这里'}}</view></view>
  <view class="log-list surface" wx:if="{{list.length}}"><view class="log" wx:for="{{list}}" wx:key="_id"><view class="top"><view><view class="log-product" wx:if="{{global}}">{{item.productName}}{{item.specification?' · '+item.specification:''}}</view><text>{{item.typeLabel}}</text></view><text class="change {{item.changeQuantity>0?'plus':(item.changeQuantity<0?'minus':'')}}">{{item.changeDisplay}}</text></view><view class="flow"><text>{{item.beforeStock}}</text><text>→</text><text>{{item.afterStock}}</text></view><view class="cost" wx:if="{{item.type==='STOCK_IN'&&item.newCostPriceDisplay}}">进货价 ¥{{item.newCostPriceDisplay}}</view><view class="meta"><text>{{item.timeDisplay}}</text><text>{{item.operatorName||'未知操作人'}}</text></view><view class="remark" wx:if="{{item.remark}}">{{item.remark}}</view></view></view>
  <view class="list-footer" wx:if="{{loading}}">正在加载…</view><view class="list-footer" wx:elif="{{list.length&&!hasMore}}">已显示全部记录</view>
</view>
