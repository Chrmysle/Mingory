.sell-hub { padding-top: 30rpx; }
.hub-header { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.hub-header > view:first-child { min-width: 0; }
.operator { flex: none; max-width: 180rpx; overflow: hidden; padding: 9rpx 16rpx; border-radius: 999rpx; color: var(--color-text-secondary); font-size: 23rpx; text-overflow: ellipsis; white-space: nowrap; background: var(--color-surface-subtle); }
.scan-sale { width: 100%; min-height: 112rpx; margin: 28rpx 0 16rpx; color: #07150f; font-size: 32rpx; background: var(--color-success); }
.search-panel { display: grid; grid-template-columns: minmax(0, 1fr) 132rpx; gap: 12rpx; }
.search-input { min-width: 0; height: 92rpx; padding: 0 22rpx; border: 1rpx solid var(--color-border); border-radius: var(--radius-sm); font-size: 28rpx; background: var(--color-surface); }
.search-button { min-height: 92rpx; margin: 0; padding: 0; color: #07121e; background: var(--color-primary); }
.search-results,.recent-list,.pending-list { margin-top: 16rpx; padding: 0 24rpx; }
.result-row,.recent-row { display: flex; align-items: center; gap: 16rpx; min-height: 108rpx; border-bottom: 1rpx solid var(--color-border); transition: transform 120ms var(--ease-out), opacity 120ms ease; }
.result-row:last-child,.recent-row:last-child { border-bottom: 0; }
.result-main,.recent-main { min-width: 0; flex: 1; }
.result-name,.recent-name { overflow: hidden; font-size: 29rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.result-meta,.recent-meta { margin-top: 4rpx; color: var(--color-text-tertiary); font-size: 23rpx; }
.result-price,.recent-amount { flex: none; font-size: 29rpx; font-weight: 650; }
.chevron { color: var(--color-text-tertiary); font-size: 38rpx; }
.cart { padding: 0 24rpx 24rpx; }
.cart-row { padding: 23rpx 0; border-bottom: 1rpx solid var(--color-border); }
.cart-head,.cart-title,.cart-controls,.cart-summary,.pending-top { display: flex; align-items: center; }
.cart-head,.cart-summary,.pending-top { justify-content: space-between; gap: 18rpx; }
.cart-title { min-width: 0; gap: 10rpx; font-size: 29rpx; font-weight: 650; }
.cart-title > text:first-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.gift-tag { flex: none; padding: 3rpx 9rpx; border-radius: 999rpx; color: var(--color-warning); font-size: 20rpx; background: var(--color-warning-soft); }
.line-total { flex: none; font-size: 29rpx; font-weight: 650; }
.cart-controls { flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }
.quantity-control { display: grid; grid-template-columns: 64rpx minmax(72rpx, auto) 64rpx; align-items: center; overflow: hidden; border: 1rpx solid var(--color-border); border-radius: 10rpx; }
.quantity-control button { width: 64rpx; min-height: 64rpx; margin: 0; padding: 0; color: var(--color-primary); background: var(--color-surface-subtle); }
.quantity-control text { min-width: 72rpx; padding: 0 8rpx; text-align: center; }
.price-control { display: flex; min-width: 210rpx; height: 66rpx; flex: 1; align-items: center; padding: 0 12rpx; border: 1rpx solid var(--color-border); border-radius: 10rpx; color: var(--color-text-tertiary); font-size: 23rpx; background: var(--color-surface-subtle); }
.price-control input { min-width: 0; height: 64rpx; flex: 1; color: var(--color-text); font-size: 27rpx; }
.gift-button { width: 142rpx; min-height: 66rpx; margin: 0; padding: 0 12rpx; color: var(--color-warning); font-size: 23rpx; background: var(--color-warning-soft); }
.gift-button.active { color: var(--color-text-secondary); background: var(--color-surface-subtle); }
.cart-summary { padding: 24rpx 0; }
.cart-summary > view { display: flex; flex-direction: column; }
.cart-summary > view:first-child text:first-child { font-size: 29rpx; font-weight: 650; }
.cart-summary > view:first-child text:last-child,.cart-summary > view:last-child text:first-child { color: var(--color-text-tertiary); font-size: 21rpx; }
.cart-summary > view:last-child { align-items: flex-end; }
.cart-summary > view:last-child text:last-child { font-size: 39rpx; font-weight: 720; }
.checkout-actions { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 12rpx; }
.checkout-actions button { margin: 0; }
.cart-empty { padding: 46rpx 24rpx; color: var(--color-text-secondary); text-align: center; }
.cart-empty view:last-child { margin-top: 7rpx; color: var(--color-text-tertiary); font-size: 23rpx; }
.pending-list { margin-top: 0; }
.pending-row { display: grid; grid-template-columns: minmax(0, 1fr) 96rpx; gap: 14rpx; align-items: center; min-height: 106rpx; border-bottom: 1rpx solid var(--color-border); }
.pending-row:last-child { border-bottom: 0; }
.pending-main { min-width: 0; padding: 17rpx 0; }
.pending-top text:first-child { font-size: 28rpx; font-weight: 620; }
.pending-top text:last-child { font-weight: 650; }
.pending-meta { margin-top: 4rpx; color: var(--color-text-tertiary); font-size: 22rpx; }
.pending-delete { width: 96rpx; min-height: 64rpx; margin: 0; padding: 0; color: var(--color-danger); font-size: 23rpx; background: var(--color-danger-soft); }
.success-panel { margin-top: 26rpx; padding: 30rpx; text-align: center; }
.success-mark { display: flex; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; margin: 0 auto 12rpx; border-radius: 50%; color: #07150f; font-size: 40rpx; font-weight: 700; background: var(--color-success); }
.success-title { font-size: 34rpx; font-weight: 700; }
.success-meta { margin-top: 5rpx; color: var(--color-text-secondary); }
.success-amount { margin: 8rpx 0 22rpx; font-size: 43rpx; font-weight: 720; }
.search-empty,.inline-error,.compact-loading { padding: 24rpx 8rpx 0; color: var(--color-text-tertiary); font-size: 24rpx; text-align: center; }
.inline-error { color: var(--color-danger); }
.compact-empty { padding: 48rpx 24rpx; color: var(--color-text-tertiary); text-align: center; }
