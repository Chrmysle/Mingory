.member-page { padding-top: 30rpx; }
.section-heading { display: flex; align-items: flex-end; justify-content: space-between; margin: 38rpx 2rpx 16rpx; }
.request-list { display: flex; flex-direction: column; gap: 18rpx; }
.request-card { padding: 26rpx; }
.request-meta { color: var(--color-text-tertiary); font-size: 23rpx; }
.member-name-input { box-sizing: border-box; width: 100%; height: 88rpx; margin-top: 15rpx; padding: 0 22rpx; border: 1rpx solid var(--color-border); border-radius: 12rpx; font-size: 28rpx; background: var(--color-surface-subtle); }
.request-actions { display: grid; grid-template-columns: 1fr 1.6fr; gap: 14rpx; margin-top: 16rpx; }
.request-actions button { min-height: 84rpx; margin: 0; }
.reject-button { color: var(--color-danger); background: var(--color-danger-soft); }
.approve-button { color: #fff; background: var(--color-primary); }
.member-list { padding: 0 24rpx; }
.member-row { display: flex; min-height: 104rpx; align-items: center; gap: 18rpx; border-bottom: 1rpx solid var(--color-border); }
.member-row:last-child { border-bottom: 0; }
.member-avatar { display: flex; width: 58rpx; height: 58rpx; align-items: center; justify-content: center; border-radius: 50%; color: var(--color-primary); font-size: 25rpx; font-weight: 650; background: var(--color-primary-soft); }
.member-name { min-width: 0; flex: 1; font-size: 28rpx; font-weight: 600; }
.enabled-badge { color: var(--color-success); font-size: 23rpx; }
.list-footer { padding: 36rpx 0; color: var(--color-text-tertiary); text-align: center; }
